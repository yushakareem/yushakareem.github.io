source "https://rubygems.org"

# Local preview only — production is built natively by GitHub Pages.
# (The version-pinning `github-pages` gem needs an old C++ native extension
# that won't build on this machine; plain Jekyll previews this site identically.)
gem "jekyll"

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-feed"
  gem "jekyll-sitemap"
end

# Not bundled with Ruby 3+; Jekyll's local server needs it.
gem "webrick"
